# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/.android-sdk/
/generated-artifacts/
/artifacts/signal-soundboard/android/app/build/
/artifacts/signal-soundboard/android/app/src/main/assets/site/
/artifacts/signal-soundboard/dist/android-web/
